# Copy to .env and fill in real values locally. Never commit .env — see .gitignore.

NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=

# JWT (access token in memory on the client, refresh token in an HttpOnly cookie)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=14d

# Frontend origin — used for CORS and for building redirect/callback URLs
CLIENT_URL=http://localhost:5173

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (transactional email)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_LOGO_URL=
SUPPORT_EMAIL=

# --- Google OIDC sign-in (Authorization Code + PKCE) ---
# From Google Cloud Console > APIs & Services > Credentials.
# GOOGLE_REDIRECT_URI must exactly match the authorised redirect URI
# registered there (including scheme, host, port and no trailing slash).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Signs the short-lived OAuth state/nonce/PKCE cookie so it can't be edited
# in transit. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
